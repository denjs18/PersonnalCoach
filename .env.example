# ---------------------------------------------------------------------------
# 1) Base de données Postgres (Neon — gratuit, voir README)
#    Copie l'URL "pooled connection" de Neon.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# 2) Codes d'accès (4 à 8 chiffres, choisis ce que tu veux)
# ---------------------------------------------------------------------------
COACH_PIN="1234"
ATHLETE_PIN="0000"

# ---------------------------------------------------------------------------
# 3) Secret de signature des sessions
#    Génère-le avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"
